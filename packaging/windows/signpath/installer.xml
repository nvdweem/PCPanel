<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installer": the Inno Setup installer built by the
  Windows job of .github/workflows/build-and-release.yml from the already signed
  PCPanel.exe. GitHub artifacts always arrive zipped, hence the zip-file root.

  The product name is Inno's AppName (packaging/windows/pcpanel.iss). Inno pads it with spaces
  to 60 characters, and SignPath compares it exactly (no wildcards), so the restriction is
  "PCPanel" followed by 53 spaces, written as &#32; so no editor trims them. The product version
  is padded to 50 characters the same way; the workflow passes it padded as the "version" parameter.
  This file is the source of truth; paste it into the SignPath project when it changes.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true"/>
  </parameters>
  <zip-file>
    <pe-file path="PCPanel-*-setup.exe" product-name="PCPanel&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;" product-version="${version}">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
