// Version resource of SndCtrl.dll. CMake fills in the version (SNDCTRL_VERSION); the product name is
// what the SignPath artifact configuration (packaging/windows/signpath/sndctrl.xml) checks before signing.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SNDCTRL_VERSION_COMMAS@
 PRODUCTVERSION @SNDCTRL_VERSION_COMMAS@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName", "PCPanel"
            VALUE "FileDescription", "PCPanel audio control"
            VALUE "FileVersion", "@SNDCTRL_VERSION@"
            VALUE "ProductVersion", "@SNDCTRL_VERSION@"
            VALUE "InternalName", "SndCtrl"
            VALUE "OriginalFilename", "SndCtrl.dll"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
